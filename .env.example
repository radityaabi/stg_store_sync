# SurveyToGo (Dooblo) REST API credentials.
# Copy this file to .env and fill real values. .env is gitignored.

# STG REST base URL (your server root, without a trailing slash)
STG_SERVER=https://YOUR_STG_HOST/api

# STG Studio account (HTTP Basic auth)
STG_USER=your_username
STG_PASSWORD=your_password
