# SurveyToGo (Dooblo) REST API credentials.
# Copy this file to .env and fill real values. .env is gitignored.

# STG REST base URL (your server root, without a trailing slash)
STG_SERVER=https://YOUR_STG_HOST/api

# STG Studio account (HTTP Basic auth)
STG_USER=your_username
STG_PASSWORD=your_password

# Optional: SimpleExport concurrency (default 4, clamped to 1-8).
# This is the main knob on a slow link: the pull is one request per 100 ids,
# so a 1500-interview survey is 16 round-trips. Each worker gets its own
# session; results stay in interview order.
# STG_EXPORT_WORKERS=4

# Optional: ids per SimpleExport request (default 100).
# 100 is the server's hard ceiling — higher values are clamped, because STG
# answers `Too many Subject IDs` and the reply would read as zero rows.
# STG_EXPORT_CHUNK=100

# Run-notification email (OWA via Playwright). Requires the `owa` extra:
#   pip install -e ".[owa]"
# The browser is deliberately NOT headless — sign in to Outlook Web once when
# the Playwright window opens; the session persists in the profile dir below.
#
# The account to click when OWA shows the Microsoft account picker:
STG_OWA_EMAIL=you@company.com
# Optional. Persistent browser profile (default ~/.stg_store_sync/playwright_profile_owa):
# STG_OWA_PROFILE_DIR=/path/to/playwright_profile_owa
